{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dylan-shi/task-tree/schema/tree.schema.json",
  "title": "task-tree tree.json",
  "type": "object",
  "required": ["program", "title", "mission", "branches", "nodes"],
  "additionalProperties": true,
  "properties": {
    "program": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Short slug; also the output folder name."
    },
    "title": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["who", "does"],
        "additionalProperties": true,
        "properties": {
          "who": { "type": "string" },
          "does": { "type": "string" }
        }
      }
    },
    "mission": {
      "type": "object",
      "required": ["why", "who", "success"],
      "additionalProperties": true,
      "properties": {
        "why": { "type": "string" },
        "source": { "type": "string" },
        "who": { "type": "string" },
        "who_source": { "type": "string" },
        "who_secondary": { "type": "string" },
        "who_secondary_source": { "type": "string" },
        "non_goals": { "type": "array", "items": { "type": "string" } },
        "success": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "nodes": { "type": "array", "items": { "type": "string" } },
              "elements": { "type": "array", "items": { "type": "string" } },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "branches": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["why"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "why": { "type": "string" },
          "serves": { "type": "array", "items": { "type": "string" } },
          "quotes": { "type": "array" },
          "prompt_categories": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "branch", "title", "state", "judge", "next"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "branch": { "type": "string" },
          "title": { "type": "string" },
          "state": {
            "enum": ["done", "partial", "open", "decide", "blocked", "later"]
          },
          "owner": { "type": "string" },
          "judge": { "type": "string" },
          "next": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "decision_ids": { "type": "array", "items": { "type": "string" } },
          "lessons": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["approved", "proposed", "deferred", "rejected"] },
          "decision": { "type": "string" }
        }
      }
    },
    "calibrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind", "title"],
        "additionalProperties": true,
        "properties": {
          "date": { "type": "string" },
          "kind": { "enum": ["目标", "方案", "范围"] },
          "title": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "decision": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "drift_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "canonical", "stale_patterns"],
        "additionalProperties": true,
        "properties": {
          "topic": { "type": "string" },
          "canonical": { "type": "string" },
          "stale_patterns": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "deleted": {
      "type": "array",
      "description": "删除 pass 的记录：删了什么、为什么、日期。",
      "items": {
        "type": "object",
        "required": ["what"],
        "additionalProperties": true,
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "automation": {
      "type": "array",
      "description": "已验证流程的自动化记录；没有手工验证证据就不要写。",
      "items": {
        "type": "object",
        "required": ["what"],
        "additionalProperties": true,
        "properties": {
          "what": { "type": "string" },
          "validated_by": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "drift_files": { "type": "array", "items": { "type": "string" } },
    "current": { "type": "string" },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "date": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
